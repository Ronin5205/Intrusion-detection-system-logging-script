{
  "log_directory": "/var/log/snort",
  "file_patterns": ["unified2.log*", "snort.u2*", "snort.log*", "merged.log*"],
  "sid_msg_map": "/etc/snort/community-sid-msg.map",
  "extra_sid_msg_maps": ["config/local-sid-msg.map"],
  "gen_msg_map": "/etc/snort/gen-msg.map",
  "classification_config": "/etc/snort/classification.config",
  "output_csv": "reports/alerts.csv",
  "output_summary": "reports/summary.txt",
  "state_directory": ".state",
  "watch_mode": true,
  "poll_interval_seconds": 2,
  "report_interval_seconds": 5,
  "debounce_seconds": 0.2,
  "scan_threshold": 20,
  "time_window_seconds": 60,
  "icmp_flood_threshold": 50,
  "brute_force_threshold": 10,
  "brute_force_keywords": ["login", "ssh", "ftp", "rdp", "authentication"],
  "suspicious_host_min_signatures": 3,
  "suspicious_host_window_seconds": 120,
  "critical_priority": 1,
  "medium_alert_threshold": 5
}
